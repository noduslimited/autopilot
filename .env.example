# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Anthropic
ANTHROPIC_API_KEY=[api-key]
# Only required if ANTHROPIC_API_KEY is an identity-linked key (Anthropic
# Console → Settings → Workspaces). Not needed for a standard project key.
ANTHROPIC_WORKSPACE_ID=

# Stripe
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is in the TRD's env var list but is not
# read anywhere in the codebase — checkout uses a server-side redirect to a
# hosted Stripe Checkout Session, not client-side Stripe.js/Elements, so it's
# not actually needed. Left out rather than set-and-unused.
STRIPE_SECRET_KEY=[secret-key]
STRIPE_WEBHOOK_SECRET=[webhook-signing-secret]
STRIPE_PRICE_ESSENTIAL=[price-id]
STRIPE_PRICE_GROWTH=[price-id]
STRIPE_PRICE_PROFESSIONAL=[price-id]

# Resend (email)
RESEND_API_KEY=[api-key]

# Web Push (carer shift notifications — see CLAUDE.md section 16a)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is used client-side (Next.js app, this file's
# scope). VAPID_PRIVATE_KEY is used only inside the shift-notifications
# Supabase Edge Function (Deno.env.get) — it's a Supabase secret, set via
# `supabase secrets set`, and is NOT a Netlify/Next.js environment variable.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=[vapid-public-key]

# App
NEXT_PUBLIC_APP_URL=https://autopilot.noduslimited.co.uk
NEXT_PUBLIC_APP_ENV=development
